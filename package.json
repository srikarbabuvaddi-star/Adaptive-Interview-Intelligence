{
  "name": "adaptive-interview-intelligence-backend",
  "version": "1.0.0",
  "description": "Backend for Adaptive Interview Intelligence - AI-powered adaptive interview platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit",
    "mcp": "node src/mcp/cli.js",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "keywords": [
    "express",
    "firebase",
    "firestore",
    "gemini",
    "ai-interview",
    "adaptive-interview"
  ],
  "author": "Adaptive Interview Intelligence Team",
  "license": "ISC",
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@google/genai": "^2.28.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.0.0",
    "mammoth": "^1.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "uuid": "^11.1.0",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
