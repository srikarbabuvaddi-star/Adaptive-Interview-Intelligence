# ========================================================
# Adaptive Interview Intelligence - Environment Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_change_in_production

# Firebase Admin SDK Configuration
# Option A: Path to serviceAccountKey.json downloaded from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Individual environment credentials (ideal for Cloud Run, Heroku, Render)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# For FIREBASE_PRIVATE_KEY, wrap in quotes and keep literal \n or escaped newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...==\n-----END PRIVATE KEY-----\n"

# Google Gemini AI Integration
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Custom AI Engine Teammate Integration (Optional)
# If your teammate hosts an alternate microservice interview engine:
AI_ENGINE_PROVIDER=gemini
AI_ENGINE_URL=http://localhost:8000/api/ai
AI_ENGINE_API_KEY=optional_custom_api_key

# Job Market Data Providers
# Primary: JSearch via RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
JOB_DATA_PROVIDER=jsearch
JSEARCH_API_KEY=your_rapidapi_jsearch_key_here
JSEARCH_API_HOST=jsearch.p.rapidapi.com

# Alternative: Adzuna Job Market & Salary Data (https://developer.adzuna.com/)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Job Cache TTL in milliseconds (default 15 minutes = 900000)
JOB_CACHE_TTL_MS=900000

# Advanced Telemetry, Observability & Distributed Queues (Optional)
OTEL_SERVICE_NAME=adaptive-interview-intelligence
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
REDIS_URL=redis://localhost:6379

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
DEBUG=false

